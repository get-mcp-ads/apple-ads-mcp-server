# apple-ads-mcp-server configuration. See the README.

# Shown in Apple Ads under Account Settings > API after you upload your public key.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=

# The EC P-256 private key that matches the uploaded public key. Set exactly one:
# the absolute path to the PEM file, or the PEM text itself.
APPLE_ADS_PRIVATE_KEY_PATH=
# APPLE_ADS_PRIVATE_KEY=

# Required, even for reads: comma-separated ad account IDs this server may use.
APPLE_ADS_AD_ACCOUNT_IDS=

# Write tools are off by default. Only the exact value true exposes them.
# Every write still previews first and applies only with confirm: true.
APPLE_ADS_ENABLE_WRITES=false
